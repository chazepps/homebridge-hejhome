{
  "pluginAlias": "Hejhome",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "customUiPath": "./homebridge-ui",
  "strictValidation": true,
  "schema": {
    "type": "object",
    "required": [
      "name"
    ],
    "additionalProperties": false,
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Hejhome"
      },
      "auth": {
        "title": "Hejhome Login State",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "identifier": {
            "title": "\uc774\uba54\uc77c",
            "type": "string"
          },
          "sessionConfigured": {
            "title": "Session Configured",
            "type": "boolean",
            "default": false
          }
        }
      },
      "scope": {
        "title": "\uc9d1/\ubc29 \uc120\ud0dd",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "title": "\uc7a5\ube44\ub97c \ubd88\ub7ec\uc62c \ubc94\uc704",
            "type": "string",
            "default": "first-family",
            "oneOf": [
              {
                "title": "\uccab \ubc88\uc9f8 \uc9d1",
                "enum": [
                  "first-family"
                ]
              },
              {
                "title": "\ubaa8\ub4e0 \uc9d1",
                "enum": [
                  "all"
                ]
              },
              {
                "title": "\uc9c1\uc811 \uc120\ud0dd",
                "enum": [
                  "custom"
                ]
              }
            ]
          },
          "includedFamilyIds": {
            "title": "\uc120\ud0dd\ud55c \uc9d1",
            "type": "array",
            "items": {
              "type": "number"
            },
            "default": []
          },
          "includedRoomsByFamilyId": {
            "title": "\uc120\ud0dd\ud55c \ubc29",
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "default": {}
          }
        }
      },
      "debug": {
        "title": "Debug Logging",
        "type": "boolean",
        "default": false
      },
      "features": {
        "type": "object",
        "title": "Beta features",
        "additionalProperties": false,
        "properties": {
          "devices": {
            "title": "장치별 표시 설정 / Device settings",
            "type": "object",
            "default": {},
            "propertyNames": {
              "pattern": "^(?!__proto__$|prototype$|constructor$).{1,128}$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "visibility": {
                  "type": "string",
                  "enum": ["both", "homekit", "matter", "hidden"]
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "role": {
                  "type": "string",
                  "enum": ["original", "light", "outlet", "switch"]
                },
                "temperatureSensorId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "freshnessMinutes": {
                  "type": "integer",
                  "minimum": 5,
                  "maximum": 1440
                },
                "remoteButtons": {
                  "type": "boolean"
                },
                "pm25Multiplier": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "matter": {
            "type": "boolean",
            "default": false
          },
          "adaptiveLighting": {
            "type": "boolean",
            "default": false
          },
          "meters": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "required": [
                "model"
              ],
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "power": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "multiplier"
                  ],
                  "properties": {
                    "field": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
                    },
                    "multiplier": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                },
                "voltage": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "multiplier"
                  ],
                  "properties": {
                    "field": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
                    },
                    "multiplier": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                },
                "current": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "multiplier"
                  ],
                  "properties": {
                    "field": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
                    },
                    "multiplier": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                },
                "energy": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "multiplier"
                  ],
                  "properties": {
                    "field": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
                    },
                    "multiplier": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
